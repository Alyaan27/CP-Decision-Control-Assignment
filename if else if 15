#include <iostream>
using namespace std;

int main() {
    int age;

    cout << "Enter your age: ";
    cin >> age;

    if (age < 5)
        cout << "Ticket is FREE";
    else if (age < 13)
        cout << "Child Ticket: Rs. 300";
    else if (age < 19)
        cout << "Teenager Ticket: Rs. 500";
    else if (age < 60)
        cout << "Adult Ticket: Rs. 800";
    else
        cout << "Senior Citizen Ticket: Rs. 400";

    return 0;
}
